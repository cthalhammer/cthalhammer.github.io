---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@/layouts/Base.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import fs from "node:fs";
import path from "node:path";

export async function getStaticPaths() {
	const teaching = await getCollection("teaching");
	return teaching.map((course) => ({
		params: { slug: course.slug },
		props: { course },
	}));
}

interface Props {
	course: CollectionEntry<"teaching">;
}

const { course } = Astro.props;
const { Content } = await course.render();

// Materials starting with "/" are files in public/ and are shown as downloads
function formatSize(bytes: number) {
	if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
	return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

const downloads = course.data.materials
	.filter((material) => material.url.startsWith("/"))
	.map((material) => {
		const filePath = path.join(process.cwd(), "public", decodeURI(material.url));
		const size = fs.existsSync(filePath) ? formatSize(fs.statSync(filePath).size) : undefined;
		const type = path.extname(material.url).slice(1).toUpperCase();
		return { ...material, size, type };
	});
const links = course.data.materials.filter((material) => !material.url.startsWith("/"));
---

<PageLayout meta={{ title: course.data.title, description: course.data.description || "" }}>
	<article>
		<header class="mb-8">
			<h1 class="title mb-4">{course.data.title}</h1>

			<div class="mb-4 flex flex-wrap gap-4 text-sm text-gray-600 dark:text-gray-400">
				<div class="flex items-center gap-2">
					<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-6m-8 0h2m8 0V9a2 2 0 00-2-2H9a2 2 0 00-2 2v12"
						></path>
					</svg>
					<span>{course.data.institution}</span>
				</div>
				<div class="flex items-center gap-2">
					<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
						></path>
					</svg>
					<span>{course.data.semester} {course.data.year}</span>
				</div>
				<div class="flex items-center gap-2">
					<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
					</svg>
					<span>{course.data.role}</span>
				</div>
			</div>

			{
				course.data.description && (
					<p class="mb-6 text-lg text-gray-700 dark:text-gray-300">{course.data.description}</p>
				)
			}

			{
				course.data.topics && course.data.topics.length > 0 && (
					<div class="mb-6">
						<h2 class="mb-3 text-base font-semibold">Topics Covered:</h2>
						<div class="flex flex-wrap gap-2">
							{course.data.topics.map((topic) => (
								<span class="rounded bg-green-100 px-3 py-1 text-sm text-green-800 dark:bg-green-900/30 dark:text-green-200">
									{topic}
								</span>
							))}
						</div>
					</div>
				)
			}

			{
				(course.data.polyboxLink || course.data.materials.length > 0) && (
					<div class="mb-8">
						<h2 class="mb-3 text-base font-semibold">Course Materials:</h2>
						{downloads.length > 0 && (
							<ul class="mb-4 divide-y divide-gray-200 border-y border-gray-200 dark:divide-gray-700 dark:border-gray-700">
								{downloads.map((file) => (
									<li>
										<a
											href={file.url}
											download
											class="group flex items-center gap-3 px-1 py-2.5 text-sm hover:bg-gray-50 dark:hover:bg-gray-800/50"
										>
											<svg class="h-4 w-4 shrink-0 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
												/>
											</svg>
											<span class="flex-1 text-gray-900 group-hover:underline dark:text-gray-100">{file.name}</span>
											<span class="text-xs whitespace-nowrap text-gray-500 dark:text-gray-400">
												{[file.type, file.size].filter(Boolean).join(" · ")}
											</span>
											<svg class="h-4 w-4 shrink-0 text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
												/>
											</svg>
										</a>
									</li>
								))}
							</ul>
						)}
						<div class="flex flex-wrap gap-4">
							{course.data.polyboxLink && (
								<a
									href={course.data.polyboxLink}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-2 rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-600"
								>
									<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
										/>
									</svg>
									Polybox Folder
								</a>
							)}
							{links.map((material) => (
									<a
										href={material.url}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
									>
										<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2"
												d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
											/>
										</svg>
										{material.name}
									</a>
								))}
						</div>
					</div>
				)
			}
		</header>

		<div class="prose prose-cactus max-w-none">
			<Content />
		</div>

		<footer class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-700">
			<div class="flex items-center justify-between">
				<a
					href="/teaching/"
					class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
				>
					<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M15 19l-7-7 7-7"></path>
					</svg>
					Back to Teaching
				</a>
				<div class="text-sm text-gray-500 dark:text-gray-400">
					<FormattedDate date={course.data.publishDate} />
				</div>
			</div>
		</footer>
	</article>
</PageLayout>
